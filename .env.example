# ===========================================
# TOCR 環境變數設定範本
# ===========================================
# 複製此檔案為 .env.local 並填入實際值
# cp .env.example .env.local

# -------------------------------------------
# 資料庫設定
# -------------------------------------------
# PostgreSQL 連線字串
# 格式: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/tocr"

# -------------------------------------------
# Auth.js 認證設定
# -------------------------------------------
# 用於加密 session 的密鑰（至少 32 字元）
# 可使用 openssl rand -base64 32 產生
AUTH_SECRET="your-auth-secret-at-least-32-characters-long"

# Google OAuth 2.0 憑證
# 從 Google Cloud Console 取得:
# https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# 自動設為 ADMIN 的 email（逗號分隔，選擇性）
# ADMIN_EMAILS="admin@example.com,another@example.com"

# -------------------------------------------
# AI OCR 服務設定（選擇性）
# -------------------------------------------
# 預設 OCR 服務提供者: claude | openai | gemini
DEFAULT_OCR_PROVIDER="claude"

# Anthropic Claude API Key
# 從 https://console.anthropic.com/ 取得
ANTHROPIC_API_KEY="sk-ant-..."

# OpenAI API Key (選擇性，若使用 OpenAI)
# OPENAI_API_KEY="sk-..."

# OpenAI 相容端點（選擇性）
# 指向任何 OpenAI 相容的 API（vLLM、Ollama、SGLang 等），用於自架模型。
# 留空則使用 OpenAI 官方 API。注意 OPENAI_API_KEY 仍須有值，
# 因為 provider 可用性是依環境變數是否存在來判斷。
# OPENAI_BASE_URL="https://your-endpoint.example.com/v1"
# OPENAI_MODEL="Qwen3-VL-30B-Instruct"

# 關閉思考模式（選擇性，僅適用於 Ollama 後端的自架端點）
# thinking 模型的思考鏈與答案共用 max_tokens 預算。辨識一頁密集目錄時，
# 思考鏈可能吃光整個預算，回傳 finish_reason="length" 且 content 為空，
# 表現就是「辨識不出任何文章」。設為 true 會送出 Ollama 的 think:false。
# 這不是 OpenAI 官方參數，指向官方 API 時不要開啟。
# OPENAI_DISABLE_THINKING="true"

# 覆寫 max_tokens（選擇性，預設 8192）
# OPENAI_MAX_TOKENS="16384"

# Google AI API Key (選擇性，若使用 Gemini)
# GOOGLE_AI_API_KEY="..."

# RAWG API Key (選擇性，用於自動抓取遊戲封面)
# 從 https://rawg.io/apidocs 取得
# RAWG_API_KEY="your-rawg-api-key"

# -------------------------------------------
# 檔案儲存設定
# -------------------------------------------
# Vercel Blob 存取 Token
# 從 Vercel Dashboard > Storage > Blob 取得
BLOB_READ_WRITE_TOKEN="vercel_blob_..."

# -------------------------------------------
# 應用程式設定（選擇性）
# -------------------------------------------
# 網站 URL（部署時設定）
# 除了 Auth.js，這也是伺服器端判斷「哪些圖片網址算自己人」的錨點
# （見 src/lib/site-origin.ts）。未設定時依序取 VERCEL_PROJECT_PRODUCTION_URL
# （專案正式網域）、VERCEL_URL（該次部署的網址），本機則是 http://localhost:3000
# ——所以 dev server 換 port 時要跟著設。兩個 Vercel 網域都會被視為自己人。
# NEXTAUTH_URL="https://your-domain.com"

# 開發環境設定
# NODE_ENV="development"

# Google Analytics 4 測量 ID（選擇性）
# 設了才會掛分析，所以本機與 preview 預設不送資料——留空是刻意的。
# 只掛在前台 layout，/admin 與 /auth 不算進去（見 src/app/(public)/layout.tsx）。
# 這不是密鑰：它會出現在每個訪客的頁面原始碼裡，走環境變數是為了讓「哪個環境
# 要送」由部署決定。正式站那把設在 Vercel，改了要 redeploy 才生效。
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# -------------------------------------------
# API Token（選擇性）
# -------------------------------------------
# 供腳本批次寫入資料使用，不需要瀏覽器 session。
# 帶 `Authorization: Bearer <token>` 的寫入請求視同 ADMIN，
# 但 /api/users 仍只接受真實 session，避免 token 外洩後被拿來提權。
# 這些寫入在 edit_logs 會歸屬到「司書(NPC)」帳號。
# 留空則整個機制關閉。產生方式：openssl rand -base64 32
#
# 這裡放的是**本機專用**的一把，正式站那把是另一個獨立的值，設在 Vercel。
# 兩邊不要共用：這個檔會被 dev server 載入，正式站的密鑰不該躺在裡面。
# 要用腳本寫進正式站時，token 從 macOS Keychain 取：
#   存：security add-generic-password -s tocr-prod-api-token -a "$USER" -w <token> -U
#   取：security find-generic-password -s tocr-prod-api-token -a "$USER" -w
# 取值記得去掉引號（`tr -d '"'`）——把引號一起送進 Bearer header 會得到 401，
# 症狀看起來像 token 不對。用法見 docs/deployment.md。
# API_TOKEN="your-api-token"

# 後台頁面資料載入耗時記錄（選擇性）
# 設為 1 時，後台各頁的資料查詢會在伺服器 log 印出 `[perf] <頁面> <毫秒>`，
# 用來判斷慢的是查詢、cold start 還是瀏覽器端。預設關閉，避免正式環境洗版。
# PERF_LOG="1"   # 也接受 "true"

# 開發模式免登入繞過（僅限開發環境）
# 設為 true 時跳過 Google OAuth，以 mock ADMIN 身份直接進入後台
# DEV_BYPASS_AUTH="true"
